---
// Print-only route: renders the entire bible as one continuous document with a
// page break before each section, for headless-Chrome PDF export. Light theme
// (default tokens) for print legibility. Not linked in nav.
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';

const sections = (await getCollection('bibleSection')).sort((a, b) => a.data.section - b.data.section);
const rendered: { section: number; title: string; Content: any }[] = [];
for (const s of sections) {
  const { Content } = await render(s);
  rendered.push({ section: s.data.section, title: s.data.title, Content });
}
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Zuga Design Bible — print</title>
  <style>
    @page { margin: 18mm 15mm; }
    html, body { background: #ffffff; color: #0f172a; }
    body { font-family: var(--font-sans); line-height: 1.55; }
    .doc { max-width: 100%; padding: 0; margin: 0; }
    .cover { text-align: center; padding-top: 30mm; break-after: page; }
    .cover h1 { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 8px; }
    .cover .mark { width: 84px; height: 84px; margin: 0 auto 20px; display: block; }
    .cover p { color: #475569; font-size: 15px; }
    section.bible-page { break-before: page; padding-top: 4mm; }
    h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; }
    h2 { font-size: 24px; margin: 0 0 12px; padding-bottom: 6px; border-bottom: 2px solid #a3e635; }
    h3 { font-size: 18px; margin: 20px 0 8px; }
    p, li { font-size: 12.5px; }
    a { color: #4d7c0f; text-decoration: none; }
    table { border-collapse: collapse; width: 100%; margin: 10px 0; font-size: 11.5px; break-inside: avoid; }
    th, td { border: 1px solid #cbd5e1; padding: 4px 8px; text-align: left; }
    th { background: #f1f5f9; }
    code { font-family: var(--font-mono); background: #f1f5f9; padding: 1px 4px; border-radius: 3px; font-size: 11px; }
    pre { background: #0f172a; color: #e2e8f0; padding: 10px 12px; border-radius: 6px; overflow: hidden; white-space: pre-wrap; word-break: break-word; font-size: 10.5px; break-inside: avoid; }
    pre code { background: none; color: inherit; padding: 0; }
    blockquote { border-left: 3px solid #a3e635; margin: 10px 0; padding: 2px 14px; color: #475569; }
    img { max-width: 100%; }
  </style>
</head>
<body>
  <div class="doc">
    <div class="cover">
      <img class="mark" src="/zugabot-mark.svg" alt="" />
      <h1>Zuga Technologies Design Bible</h1>
      <p>The master visual language inherited by every Zuga product.</p>
      <p style="margin-top:6px; font-size:12px; color:#65a30d;">Master accent: acid lime #a3e635</p>
    </div>
    {rendered.map(({ section, title, Content }) => (
      <section class="bible-page">
        <h2>{section}. {title}</h2>
        <article><Content /></article>
      </section>
    ))}
  </div>
</body>
</html>
