---
// Print-only route: renders the entire bible as one continuous document with a
// page break before each section, for headless-Chrome PDF export. Light theme
// for print legibility. Not linked in nav.
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';

const sections = (await getCollection('bibleSection')).sort((a, b) => a.data.section - b.data.section);
const rendered: { Content: any }[] = [];
for (const s of sections) {
  const { Content } = await render(s);
  rendered.push({ Content });
}
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Zuga Design Bible</title>
  <style>
    @page { margin: 16mm 15mm; }
    * { box-sizing: border-box; }
    html, body { background: #ffffff; color: #1e293b; margin: 0; }
    body { font-family: var(--font-sans); }

    /* Cover */
    .cover { text-align: center; padding-top: 40mm; height: 100vh; break-after: page; }
    .cover .mark { width: 90px; height: 90px; margin: 0 auto 22px; display: block; }
    .cover h1 { font-size: 36px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 10px; color: #0f172a; border: none; padding: 0; }
    .cover p { color: #475569; font-size: 15px; margin: 4px 0; }
    .cover .accent { color: #65a30d; font-weight: 600; font-size: 13px; margin-top: 8px; }

    /* Each bible section starts on a fresh page */
    section.bible-page { break-before: page; }
    article { font-size: 12px; line-height: 1.55; color: #1e293b; }

    /* Markdown headings */
    article h1 { font-size: 23px; font-weight: 800; letter-spacing: -0.015em; margin: 0 0 16px; padding-bottom: 7px; border-bottom: 2.5px solid #a3e635; color: #0f172a; }
    article h2 { font-size: 16px; font-weight: 700; margin: 22px 0 8px; color: #0f172a; }
    article h3 { font-size: 13.5px; font-weight: 700; margin: 16px 0 5px; color: #334155; }
    article h4 { font-size: 12.5px; font-weight: 700; margin: 13px 0 4px; color: #334155; }

    /* Body */
    article p { margin: 0 0 9px; }
    article ul, article ol { margin: 0 0 9px; padding-left: 20px; }
    article li { margin: 3px 0; }
    article strong { color: #0f172a; }
    article a { color: #4d7c0f; text-decoration: none; }
    article hr { border: none; border-top: 1px solid #e2e8f0; margin: 16px 0; }

    /* Tables */
    article table { border-collapse: collapse; width: 100%; margin: 10px 0 14px; font-size: 11px; break-inside: avoid; }
    article th, article td { border: 1px solid #cbd5e1; padding: 4px 8px; text-align: left; vertical-align: top; }
    article th { background: #f1f5f9; font-weight: 700; color: #0f172a; }

    /* Code */
    article code { font-family: var(--font-mono); background: #f1f5f9; padding: 1px 5px; border-radius: 3px; font-size: 10.5px; color: #0f172a; }
    article pre { background: #0f172a; color: #e2e8f0; padding: 11px 13px; border-radius: 6px; white-space: pre-wrap; word-break: break-word; font-size: 10px; line-height: 1.4; margin: 10px 0 14px; break-inside: avoid; }
    article pre code { background: none; color: inherit; padding: 0; font-size: 10px; }

    article blockquote { border-left: 3px solid #a3e635; margin: 10px 0; padding: 4px 14px; color: #475569; background: #f8fafc; }
    article img { max-width: 100%; }
  </style>
</head>
<body>
  <div class="cover">
    <img class="mark" src="/zugabot-mark.svg" alt="" />
    <h1>Zuga Technologies Design Bible</h1>
    <p>The master visual language inherited by every Zuga product.</p>
    <p class="accent">Master accent: acid lime #a3e635</p>
  </div>
  {rendered.map(({ Content }) => (
    <section class="bible-page"><article><Content /></article></section>
  ))}
</body>
</html>
