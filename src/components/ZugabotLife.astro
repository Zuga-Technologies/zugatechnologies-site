---
/*
 * ZugabotLife — meditating variant.
 * Shares head + torso paths with Zugabot.astro byte-for-byte. Only the
 * face (eyes → peaceful closed arcs, small smile), arms (folded into lap
 * mudra), and legs (lotus base instead of standing feet) differ.
 *
 * `hover` prop adds 3 small ascending zen dots above the antenna.
 */
interface Props {
  size?: number;
  class?: string;
  hover?: boolean;
}
const { size = 160, class: className = '', hover = false } = Astro.props;
---

<svg
  width={size}
  height={size * (160 / 120)}
  viewBox="0 0 120 160"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class={className}
>
  <!-- Antenna -->
  <path d="M 78 28 L 90 14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
  <circle cx="90" cy="14" r="3" fill="currentColor" />

  <!-- Hover-only: ascending zen dots -->
  {hover && (
    <>
      <circle cx="48" cy="20" r="1.6" fill="currentColor" opacity="0.9" />
      <circle cx="40" cy="12" r="1.3" fill="currentColor" opacity="0.7" />
      <circle cx="32" cy="6"  r="1.1" fill="currentColor" opacity="0.5" />
    </>
  )}

  <!-- Head body -->
  <rect x="22" y="28" width="76" height="56" rx="11"
    fill="#c8e84a" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />

  <!-- Cyan sticker -->
  <rect x="30" y="36" width="12" height="12" rx="2.4"
    fill="#5cc4d4" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />

  <!-- Eyes — closed peaceful arcs (‿ ‿) -->
  <path d="M 43 58 Q 50 53 57 58" stroke="#1a1a1a" stroke-width="2.6" stroke-linecap="round" fill="none" />
  <path d="M 65 58 Q 72 53 79 58" stroke="#1a1a1a" stroke-width="2.6" stroke-linecap="round" fill="none" />

  <!-- Small smile -->
  <path d="M 55 74 Q 60 78 65 74" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" fill="none" />

  <!-- Chin -->
  <rect x="52" y="84" width="16" height="8" rx="1.5"
    fill="#c8e84a" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />

  <!-- Neck connector -->
  <rect x="54" y="92" width="12" height="4"
    fill="#c8e84a" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />

  <!-- Torso -->
  <rect x="24" y="96" width="72" height="48" rx="9"
    fill="#c8e84a" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />

  <!-- Chest sticker -->
  <rect x="48" y="108" width="24" height="24" rx="3"
    fill="#5cc4d4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />

  <!-- Arms — folded inward into lap mudra -->
  <!-- Left arm: shoulder (24,102) curving to lap-left -->
  <path d="M 26 104 Q 22 124 50 134" stroke="currentColor" stroke-width="10" stroke-linecap="round" fill="none" />
  <path d="M 26 104 Q 22 124 50 134" stroke="#c8e84a" stroke-width="7" stroke-linecap="round" fill="none" />
  <!-- Right arm: shoulder (96,102) curving to lap-right -->
  <path d="M 94 104 Q 98 124 70 134" stroke="currentColor" stroke-width="10" stroke-linecap="round" fill="none" />
  <path d="M 94 104 Q 98 124 70 134" stroke="#c8e84a" stroke-width="7" stroke-linecap="round" fill="none" />

  <!-- Hands resting (small dots at lap meeting points) -->
  <circle cx="50" cy="134" r="3.5" fill="#c8e84a" stroke="currentColor" stroke-width="1.8" />
  <circle cx="70" cy="134" r="3.5" fill="#c8e84a" stroke="currentColor" stroke-width="1.8" />

  <!-- Lotus base — wide crossed-legs shape -->
  <rect x="22" y="144" width="76" height="10" rx="5"
    fill="#c8e84a" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
  <!-- Subtle X to suggest crossed legs -->
  <path d="M 38 146 L 60 152 L 82 146" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none" opacity="0.5" />
</svg>
